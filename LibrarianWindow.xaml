<Window x:Class="Libra.LibrarianWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libra"
        mc:Ignorable="d"
        Title="LibrarianWindow" Height="450" Width="525">
    <Grid Margin="0,0,0,28">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0*"/>
        </Grid.RowDefinitions>
        <Button x:Name="CustomerButton" Content="Customers" FontSize="20" HorizontalAlignment="Left" Height="54" Margin="77,64,0,0" VerticalAlignment="Top" Width="158" IsDefault="True" Click="CustomerButton_Click"/>
        <Button x:Name="SaveExitButton" Content="Save and exit" FontSize="20" HorizontalAlignment="Left" Height="54" Margin="185,0,0,0" VerticalAlignment="Center" Width="165" Background="#a5d496" Click="SaveExitButton_Click"/>
        <Button x:Name="ExitButton" Content="Exit" FontSize="20" HorizontalAlignment="Left" Height="54" Margin="185,257,0,0" VerticalAlignment="Top" Width="165" Background="#FFE7B37D" Click="Exit_Click"/>
        <Button x:Name="BookButton" Content="Books" FontSize="20" HorizontalAlignment="Left" Height="54" Margin="293,64,0,0" VerticalAlignment="Top" Width="157" Click="BookButton_Click"/>

    </Grid>
</Window>
