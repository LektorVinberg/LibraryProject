<Window x:Class="Libra.LibrarianWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libra"
        mc:Ignorable="d"
        Title="Librarian" Height="385" Width="525">
    <Window.Background>
        <ImageBrush ImageSource="/Assets/books_bg.png" Stretch="UniformToFill" Opacity="0.3"/>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Button Grid.Row="0" Grid.Column="0" x:Name="CustomerButton" Content="Customers" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Height="54"  VerticalAlignment="Center" Width="158" IsDefault="True" Click="CustomerButton_Click"/>
        <Button Grid.Row="1" Grid.Column="1" x:Name="SaveExitButton" Content="Save and exit" FontSize="20" FontWeight="Bold"  HorizontalAlignment="Center" Height="54" VerticalAlignment="Center" Width="165" Background="#a5d496" Click="SaveExitButton_Click"/>
        <Button Grid.Row="1" Grid.Column="0" x:Name="ExitButton" Content="Exit" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Height="54" VerticalAlignment="Center" Width="165" Background="#FFE7B37D" Click="Exit_Click"/>
        <Button Grid.Row="0" Grid.Column="1" x:Name="BookButton" Content="Books" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Height="54" VerticalAlignment="Center" Width="157" Click="BookButton_Click"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  Width="Auto" Height="Auto">
            <Label Content="Reminder" Background="Gray"/>
            <DataGrid x:Name="ReminderGrid" ItemsSource="{Binding}" AutoGenerateColumns="False" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Book title" Binding="{Binding Title}"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Late fee" Binding="{Binding LateFee}" />
                </DataGrid.Columns>
            </DataGrid>
            <Button x:Name="Refresh" Grid.Row="2" Content="Refresh" Click="RefreshReminders"/>
        </StackPanel>
        

        <Button x:Name="ReservationButton" Content="Reservation Window" HorizontalAlignment="Left" Height="48" Margin="77,142,0,0" VerticalAlignment="Top" Width="158" Click="ReservationButton_Click"/>

    </Grid>
    
</Window>
