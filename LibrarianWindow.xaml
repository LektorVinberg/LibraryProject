<Window x:Class="Libra.LibrarianWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libra"
        mc:Ignorable="d"
        Title="LibrarianWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="CustomerButton" Content="Customer Window" HorizontalAlignment="Left" Height="54" Margin="77,64,0,0" VerticalAlignment="Top" Width="158" IsDefault="True" Click="CustomerButton_Click"/>
        <Button x:Name="SaveExitButton" Content="Save and exit" HorizontalAlignment="Left" Height="48" Margin="536,70,0,0" VerticalAlignment="Top" Width="165" Click="SaveExitButton_Click"/>
        <Button x:Name="ExitButton" Content="Exit" HorizontalAlignment="Left" Height="50" Margin="536,142,0,0" VerticalAlignment="Top" Width="165" Click="Exit_Click"/>
        <Button x:Name="BookButton" Content="Book Window" HorizontalAlignment="Left" Height="54" Margin="293,64,0,0" VerticalAlignment="Top" Width="157" Click="BookButton_Click"/>

    </Grid>
</Window>
