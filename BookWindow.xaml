<Window x:Class="Libra.BookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libra"
        mc:Ignorable="d"
        Title="BookWindow" Height="533" Width="1000
        ">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140*"/>
            <ColumnDefinition Width="291*"/>
            <ColumnDefinition Width="512*"/>
            <ColumnDefinition Width="57*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="63*"/>
            <RowDefinition Height="305*"/>
            <RowDefinition Height="62*"/>
        </Grid.RowDefinitions>
        <Label x:Name="BookTitleLabel" Content="Book Catalog" HorizontalAlignment="Left" Margin="144,10,0,0" VerticalAlignment="Top" Height="50" Width="246" FontSize="24" Grid.Column="1" Grid.ColumnSpan="2"/>
        <StackPanel Grid.Column="1" HorizontalAlignment="Left" Height="Auto" VerticalAlignment="Top" Width="212" Grid.Row="1" Margin="67,10,0,0">
            <Label x:Name="BookTitleLabel1" Content="Enter New Book Informaton" Height="26" Width="201"/>
            <Label x:Name="BookTitleLabel2" Content="Title" HorizontalAlignment="Left" Height="28" VerticalAlignment="Top"/>
            <TextBox x:Name="BookTitleTextBox" Height="32" TextWrapping="Wrap" Width="200" TextChanged="BookTitleTextBox_TextChanged"/>
            <Label x:Name="BookAuthorLabel" Content="Author" HorizontalAlignment="Left" Height="32" VerticalAlignment="Top"/>
            <TextBox x:Name="BookAuthorTextBox" Height="32" TextWrapping="Wrap" Width="200" TextChanged="BookAuthorTextBox_TextChanged"/>
            <Label x:Name="ISBNLabel" Content="ISBN" HorizontalAlignment="Left" Height="32" VerticalAlignment="Top"/>
            <TextBox x:Name="BookISBNTextBox" Height="32" TextWrapping="Wrap" Width="200" TextChanged="BookISBNTextBox_TextChanged"/>
            <Button x:Name="AddBookButton" Content="Add Book" FontSize="20" Margin="6,15" Height="33" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Click="AddBookButton_Click"/>
            <Label x:Name="BookCountLabel" Content="Book Count: 0" HorizontalAlignment="Left" Height="27" VerticalAlignment="Top" Width="190"/>
        </StackPanel>
        
        
        
        <Button x:Name="ExitButton" Grid.Column="2" Content="Exit" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Height="42" Margin="330,0,0,0" Grid.Row="2" VerticalAlignment="Center" Width="172" Background="#FFE7B37D" Click="ExitButton_Click"/>
        <ListBox x:Name="BookListBox" Grid.Column="2" HorizontalAlignment="Center" Height="148" Margin="0,69,0,0" Grid.Row="1" VerticalAlignment="Top" Width="492" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ISBN}" TextWrapping="Wrap" Grid.Column="0" />
                        <TextBlock Text="{Binding Author}" TextWrapping="Wrap" Grid.Column="1" />
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Grid.Column="2" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Label x:Name="BooksHeaderLabel" Grid.Column="2" Content="ISBN                     Author                            Title" HorizontalAlignment="Center" Height="32" Margin="0,37,0,0" Grid.Row="1" VerticalAlignment="Top" Width="492"/>
        <!-- Button with attached ContextMenu -->
        <Button x:Name="MenuButton" Grid.Column="2" Content="AllFields" FontSize="20" HorizontalAlignment="Left" Margin="367,0,0,0" Grid.Row="1" VerticalAlignment="Top" Height="34" Width="116" Click="MenuButton_Click">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="AllFields" Click="MenuItem_Click" />
                    <MenuItem Header="ISBN" Click="MenuItem_Click" />
                    <MenuItem Header="Author" Click="MenuItem_Click"/>
                    <MenuItem Header="Title" Click="MenuItem_Click"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <TextBox x:Name="SearchTextBox" Grid.Column="2" HorizontalAlignment="Left" Height="24" Margin="10,3,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="311" TextChanged="SearchTextBox_TextChanged"/>
        <Label Grid.Column="2" Content="Enter search string                                                         Search Mode" HorizontalAlignment="Center" Height="32" Margin="0,222,0,0" Grid.Row="1" VerticalAlignment="Top" Width="492"/>
        <Button x:Name="DeleteButton" Grid.Column="2" Content="Delete selected" FontSize="20" HorizontalAlignment="Left" Height="34" Margin="165,274,0,0" Grid.Row="1" VerticalAlignment="Top" Width="166" Click="DeleteButton_Click"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="367,44,0,0" TextWrapping="Wrap" Text="Select Filter" FontSize="20" VerticalAlignment="Top"/>

    </Grid>
</Window>
