<Window x:Class="Libra.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libra"
        mc:Ignorable="d"
        Title="ReportWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Loaned Books Report" FontSize="22" FontWeight="Bold" VerticalAlignment="Top" RenderTransformOrigin="0.52,0.488"/>
        <ListBox x:Name="ReportListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="43,44,43,50"/>
        <Button Content="Close" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,395,0,0" VerticalAlignment="Top" Background="#FFE7B37D" Click="Button_Click" Width="100"/>

    </Grid>
</Window>
